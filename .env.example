# Copy to .env and fill in. .env is git-ignored and never packaged.
# Variables already set in the real environment take precedence over this file.

# X-Target-Environment and currency for your market
MTN_ENVIRONMENT=mtnuganda
CURRENCY=UGX
# Sent as X-Callback-Url, e.g. https://example.com/momo/callback
CALLBACK_URL=
# MOMO_PROXY_URL=http://user:pass@proxy.example.com:8080

# Stay on the legacy platform until MTN confirms the new one is ready, then delete this line.
BASE_URL=https://proxy.momoapi.mtn.com

# Collections subscription key (Ocp-Apim-Subscription-Key), unchanged by the migration
COLLECTION_PRIMARY_KEY=

# Legacy platform (proxy.momoapi.mtn.com): the old API user and API key
COLLECTION_USER_ID=
COLLECTION_API_SECRET=

# New platform (momoapi.momo.africa): System Credentials from the Partner Portal.
# Read by from_env(platform="new"), `momo-openapi token --platform new` and
# examples/legacy_and_new.py, so both platforms can be used side by side.
# At cutover, move them into COLLECTION_USER_ID / COLLECTION_CREDENTIAL_TOKEN.
COLLECTION_NEW_USER_ID=
COLLECTION_NEW_CREDENTIAL_TOKEN=

# Disbursements and remittances: same rules as collections, each with its own subscription key.
# Credentials are per wallet, so a product on the same wallet can reuse the collection pair.
DISBURSEMENT_PRIMARY_KEY=
DISBURSEMENT_USER_ID=
DISBURSEMENT_API_SECRET=
DISBURSEMENT_NEW_USER_ID=
DISBURSEMENT_NEW_CREDENTIAL_TOKEN=

REMITTANCE_PRIMARY_KEY=
REMITTANCE_USER_ID=
REMITTANCE_API_SECRET=
REMITTANCE_NEW_USER_ID=
REMITTANCE_NEW_CREDENTIAL_TOKEN=

# Default --phone for examples/legacy_and_new.py, in international format (256XXXXXXXXX).
MOMO_TEST_PHONE=256760087659
